<section class="portada">
  <h1><%= titulo %></h1>
  <p class="portada__texto">
    En Mascoteros mostramos animales que buscan un hogar. Conocé a las mascotas
    en adopción, mirá su historia y sumá a las que querés ayudar.
  </p>
  <a class="boton" href="/mascotas">Ver catálogo de mascotas</a>
</section>

<section class="aliados" aria-labelledby="aliados-titulo">
  <h2 id="aliados-titulo">Marcas que nos acompañan</h2>
  <div class="aliados__logos">
    <img src="/img/1.webp" alt="Logo de Whiskas" width="400" height="200">
    <img src="/img/2.webp" alt="Logo de Sabrositos, tu mascota sabe" width="400" height="200">
    <img src="/img/3.webp" alt="Logo de Royal Canin" width="400" height="200">
    <img src="/img/4.webp" alt="Logo de Purina" width="400" height="200">
  </div>
</section>
