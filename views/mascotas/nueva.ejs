<section class="formulario-caja">
  <h1><%= titulo %></h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form action="/mascotas" method="post" class="formulario">
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" type="text" value="<%= valores.nombre ?? '' %>" required>

    <label for="especie">Especie</label>
    <input id="especie" name="especie" type="text" value="<%= valores.especie ?? '' %>" required>

    <label for="edad">Edad (en años)</label>
    <input id="edad" name="edad" type="number" min="0" max="30" step="1" value="<%= valores.edad ?? '' %>" required>

    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="">Elegí un estado</option>
      <% ["En adopción", "Reservada", "Adoptada"].forEach((opcion) => { %>
        <option value="<%= opcion %>" <%= valores.estado === opcion ? "selected" : "" %>><%= opcion %></option>
      <% }) %>
    </select>

    <label for="descripcion">Descripción</label>
    <textarea id="descripcion" name="descripcion" rows="4" required><%= valores.descripcion ?? '' %></textarea>

    <button class="boton" type="submit">Agregar mascota</button>
  </form>
</section>
